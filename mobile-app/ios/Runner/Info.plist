<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>GYMatch</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>gymatch</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- ═══ iOS Network: App Transport Security (ATS) ═══ -->
	<!-- iOS enforces stricter TLS requirements than Android. If ATS is misconfigured,
	     network requests fail with "No internet" error. Settings below ensure compatibility. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Disable ATS globally only if necessary (NOT recommended for production) -->
		<!-- <key>NSAllowsArbitraryLoads</key>
		<true/> -->
		
		<!-- Whitelist specific domains with compatible configurations -->
		<key>NSExceptionDomains</key>
		<dict>
			<!-- Production backend domain -->
			<key>gymatch.syedmisbahali.com</key>
			<dict>
				<!-- Allow standard HTTPS connection -->
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<!-- iOS requires TLS 1.2 or higher; older servers need this relaxed -->
				<key>NSExceptionMinimumTLSVersion</key>
				<string>TLSv1.2</string>
				<!-- Allow connections to subdomains (e.g., api.gymatch.syedmisbahali.com) -->
				<key>NSIncludesSubdomains</key>
				<true/>
				<!-- Allow forward secrecy ciphers (modern requirement) -->
				<key>NSExceptionRequiresForwardSecrecy</key>
				<false/>
			</dict>
			
			<!-- Development/Testing backend (if different) -->
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
			<key>127.0.0.1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>

	<!-- ═══ iOS Location Permissions ═══ -->
	<!-- Required by geolocator plugin; missing descriptions cause crashes -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>GYMatch uses your location to find nearby gyms and connect you with workout partners in your area.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>GYMatch uses your location to find nearby gyms and connect you with workout partners in your area.</string>

	<!-- ═══ iOS Network Permissions (iOS 14.5+) ═══ -->
	<!-- Required for local network discovery (Bonjour/mDNS) if used -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>GYMatch needs to communicate over your local network to enable local features.</string>
	<key>NSBonjourServiceTypes</key>
	<array>
		<string>_http._tcp</string>
		<string>_https._tcp</string>
	</array>

	<key>NSPhotoLibraryUsageDescription</key>
	<string>GYMatch needs access to your photo library so you can set a profile picture.</string>

	<!-- ═══ Google Sign-In iOS Configuration ═══ -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- Reversed iOS Client ID from Google Cloud Console -->
				<string>com.googleusercontent.apps.466640926142-8610coik3rfnead8h6k73usa7th9bq1g</string>
			</array>
		</dict>
	</array>

</dict>
</plist>

